# ==============================================================================
# Pathfinder Environment Configuration Template
# Copy this file to .env and supply your project credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Required for Frontend Web App)
# Found in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Supabase Admin Configuration (Required ONLY for Seeding & QA scripts)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role key
# CAUTION: Never expose this key in client-side code or public repositories.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. Primary Gemini API Key  [REQUIRED]
# Get a free key at: https://aistudio.google.com/app/apikey
# Used for: ALL embeddings (catalog + user queries) + primary chat/generation.
# For Edge Functions, also set via: npx supabase secrets set GEMINI_API_KEY=your-key
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# 4. Secondary Gemini API Key  [OPTIONAL — recommended]
# A second Gemini key from a DIFFERENT Google account.
# Used ONLY by embed-catalog.js as a fallback if the primary key hits its
# daily embedding quota during the one-time catalog seeding run.
# Not used at runtime (embeddings are stored in DB, not re-generated per request).
# For Edge Functions: npx supabase secrets set GEMINI_API_KEY_2=your-second-key
# ------------------------------------------------------------------------------
GEMINI_API_KEY_2=your-second-gemini-api-key

# ------------------------------------------------------------------------------
# 5. Grok API Key (xAI)  [REQUIRED for quota safety]
# Get a key at: https://console.x.ai -> API Keys -> Create
# Used for: FALLBACK chat/generation when Gemini returns 429 or quota-exhausted.
# NOTE: Grok has NO embedding API — embeddings always use Gemini above.
# For Edge Functions: npx supabase secrets set GROK_API_KEY=your-grok-key
# ------------------------------------------------------------------------------
GROK_API_KEY=your-grok-api-key
