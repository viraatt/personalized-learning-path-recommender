# ==============================================================================
# Pathfinder Environment Configuration Template
# Copy this file to .env and supply your project credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Required for Frontend Web App)
# Found in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Supabase Admin Configuration (Required ONLY for Seeding & QA scripts)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role key
# CAUTION: Never expose this key in client-side code or public repositories.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Key (Required for Supabase Edge Functions & Embedding scripts)
# Get a free key at: https://aistudio.google.com/app/apikey
# For Edge Functions, set via: npx supabase secrets set GEMINI_API_KEY=your-key
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
